# ==============================================================================
# MAANCAMERA — Environment Configuration Specification
# Document ID: MC-ENV-001 | v2.0
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=MaanCamera
APP_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# Regional and Localization Defaults (India First)
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key for session hashing and JWT token signing (change in production!)
SECRET_KEY=dev_insecure_maancamera_super_secret_key_change_in_production_32b_min
CSRF_SECRET=dev_insecure_csrf_secret_token_1234567890abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_COOKIE_NAME=mc_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Password Hashing (Argon2id configuration)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=maancamera
POSTGRES_PASSWORD=maancamera_local_dev_password
POSTGRES_DB=maancamera_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://maancamera:maancamera_local_dev_password@postgres:5432/maancamera_db
SYNC_DATABASE_URL=postgresql://maancamera:maancamera_local_dev_password@postgres:5432/maancamera_db

# ------------------------------------------------------------------------------
# 4. CACHE & BACKGROUND TASK QUEUE (Valkey / Redis Protocol)
# ------------------------------------------------------------------------------
VALKEY_HOST=valkey
VALKEY_PORT=6379
REDIS_URL=redis://valkey:6379/0
CELERY_BROKER_URL=redis://valkey:6379/1
CELERY_RESULT_BACKEND=redis://valkey:6379/2

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (SeaweedFS S3-Compatible Storage)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY_ID=maancamera_s3_admin
S3_SECRET_ACCESS_KEY=maancamera_s3_secret_key_dev
S3_BUCKET_PUBLIC_PORTFOLIOS=mc-public-portfolios
S3_BUCKET_PRIVATE_UPLOADS=mc-private-originals
S3_REGION=ap-south-1

# ------------------------------------------------------------------------------
# 6. AI ENGINE & LOCAL RUNTIME (Ollama + Open-Source Models)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=mistral:7b
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CLIP_MODEL_NAME=ViT-B-32
AI_TIMEOUT_SECONDS=15
AI_ENABLED=true

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY ADAPTER (Pluggable Architecture)
# ------------------------------------------------------------------------------
# Options: mock, razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & MONITORING (Prometheus & OpenTelemetry)
# ------------------------------------------------------------------------------
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
